# General / Navigation Shortcuts
alias c="clear"
alias h="cd ~"
alias hc="cd ~ && clear"
alias x="exit"
alias .="nvim"
alias bt="btop"
alias cm="cmatrix -xos"
alias ha="ha-cli"

# Tmux
alias t="tmux"
alias ta="tmux attach"
alias tt="tmux attach -t"
alias tl="tmux ls"
alias td="tmux detach"

# Git & Tools
alias lg="lazygit"
alias dc="docker compose"

# Modern 'eza' (replacement for ls)
alias ls="eza"
alias l="eza -alh"
alias la="eza -a"
alias ll="eza -lh"
alias lsd="eza -laDh"
alias lt="eza -alhTL 5"

# Wayland / Cliphist Clipboard Shortcuts
alias cls="cliphist list | fzf --no-sort | cliphist decode | wl-copy"
alias clr="cliphist list | fzf --no-sort | cliphist delete"

# Shell Utilities
alias sudo='sudo '                         # Enable aliases to be run with sudo
alias gurl='curl --compressed'            # Gzip-enabled curl
alias week='date +%V'                     # Get current week number
alias timer='echo "Timer started. Stop with Ctrl-D." && date && time cat && date'

# Load machine-specific local aliases if they exist (ignored by git)
if [ -f "$HOME/.aliases.local" ]; then
    source "$HOME/.aliases.local"
fi
